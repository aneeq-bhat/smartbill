# Copy this file to ".env" for local use and fill in your own values.
# NEVER commit the real .env file (it is listed in .gitignore).
# On Render, enter these as Environment Variables instead of using a file.

# ---- Flask ----------------------------------------------------------------
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
# Set to 1 when the site is served over HTTPS (Render): cookies become Secure.
SESSION_COOKIE_SECURE=0

# ---- Login (shop owner account) ---------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ---- MySQL 8 -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=smartbill
# Only if your MySQL provider requires a CA certificate:
# DB_SSL_CA=/path/to/ca.pem
# or paste the certificate text (use \n for line breaks):
# DB_SSL_CA_PEM=

# ---- Shop details printed on invoices ----------------------------------------
SHOP_NAME=Kashmir General Store
SHOP_ADDRESS=Jammu
SHOP_PHONE=
SHOP_GSTIN=

# ---- Business rule -------------------------------------------------------------
# Products with stock below this number are shown as "low stock".
LOW_STOCK_LIMIT=10
